+struct dwc_cphy_freq_range {
+	u8 hsfreq;
+	u32 min_msps;
+	u32 max_msps;
+	u32 osc_freq_target;
+};
+
+static const struct dwc_cphy_freq_range cphy_freqranges[] = {
+	{0x00,  80,  149,  335},
+	{0x10, 150,  249,  335},
+	{0x20, 250,  349,  335},
+	{0x30, 350,  449,  335},
+	{0x01, 450,  549,  335},
+	{0x11, 550,  649,  335},
+	{0x21, 650,  749,  335},
+	{0x31, 750,  899,  335},
+	{0x02, 900, 1049,  248},
+	{0x12, 1050, 1249, 248},
+	{0x22, 1250, 1499, 248},
+	{0x32, 1500, 1999, 248},
+	{0x03, 2000, 2500, 248},
+};
+#define CPHY_FREQ_RANGE_NUM ARRAY_SIZE(cphy_freqranges)
+
+static int ipu6_isys_dwc_phy_config_cphy(struct ipu6_isys *isys,
+					 u32 phy_id, u32 msps)
+{
+	struct ipu6_bus_device *adev = isys->adev;
+	struct device *dev = &adev->auxdev.dev;
+	struct ipu6_device *isp = adev->isp;
+	u32 cfg_clk_freqrange;
+	u32 osc_freq_target = 335;
+	u8 hsfreq = 0x00;
+	unsigned int i;
+
+	for (i = 0; i < CPHY_FREQ_RANGE_NUM; i++) {
+		if (msps >= cphy_freqranges[i].min_msps &&
+		    msps <= cphy_freqranges[i].max_msps) {
+			hsfreq = cphy_freqranges[i].hsfreq;
+			osc_freq_target = cphy_freqranges[i].osc_freq_target;
+			break;
+		}
+	}
+
+	dwc_dphy_write_mask(isys, phy_id, IPU6_DWC_DPHY_HSFREQRANGE,
+			    hsfreq, 0, 7);
+	dwc_dphy_ifc_write_mask(isys, phy_id, 0xe4, 0x1, 0, 1);
+	dwc_dphy_ifc_write_mask(isys, phy_id, 0xe2,
+				osc_freq_target & 0xff, 0, 8);
+	dwc_dphy_ifc_write_mask(isys, phy_id, 0xe3,
+				(osc_freq_target >> 8) & 0xf, 0, 4);
+	cfg_clk_freqrange = (isp->buttress.ref_clk - 170) * 4 / 10;
+	dwc_dphy_write_mask(isys, phy_id, IPU6_DWC_DPHY_CFGCLKFREQRANGE,
+			    cfg_clk_freqrange, 0, 8);
+	dwc_dphy_write_mask(isys, phy_id, IPU6_DWC_DPHY_DFT_CTRL2, 0x1, 4, 1);
+	dwc_dphy_write_mask(isys, phy_id, IPU6_DWC_DPHY_DFT_CTRL2, 0x1, 8, 1);
+	return 0;
+}
